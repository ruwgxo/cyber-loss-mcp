{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cyber-loss-mcp:corrections-log:1.0.0",
  "title": "cyber-loss-mcp corrections log 1.0.0",
  "description": "Append-only log. A past entry is never edited; a change is a new entry that names the entry it supersedes.",
  "type": "object",
  "required": [
    "title",
    "id",
    "updated",
    "standard",
    "profile",
    "inline_markup",
    "meta",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "$ref": "#/$defs/text_short"
    },
    "id": {
      "const": "corrections-log"
    },
    "updated": {
      "$ref": "#/$defs/date"
    },
    "standard": {
      "const": "2.0.0"
    },
    "profile": {
      "const": "../src/cyber_loss_mcp/standards/20261106__Cyber_Loss_Corrections_Log_Profile_by_Raghav_Dinesh.yaml"
    },
    "inline_markup": {
      "const": "none"
    },
    "description": {
      "$ref": "#/$defs/text_long"
    },
    "meta": {
      "type": "object",
      "required": [
        "log_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "log_schema": {
          "const": "1.0.0"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dataset_version",
          "date",
          "evidence",
          "field",
          "figure",
          "id",
          "incident",
          "new_value",
          "old_value",
          "reported_in",
          "supersedes"
        ],
        "additionalProperties": false,
        "properties": {
          "dataset_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "incident": {
            "type": "string",
            "pattern": "^inc-[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "figure": {
            "type": "string",
            "pattern": "^fig-[1-9][0-9]*$"
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "old_value": {
            "$ref": "#/$defs/text_short"
          },
          "new_value": {
            "$ref": "#/$defs/text_short"
          },
          "reported_in": {
            "$ref": "#/$defs/text_short"
          },
          "evidence": {
            "$ref": "#/$defs/text_long"
          },
          "id": {
            "type": "string",
            "pattern": "^cor-[1-9][0-9]*$"
          },
          "supersedes": {
            "type": "string",
            "pattern": "^(none|cor-[1-9][0-9]*)$"
          },
          "date": {
            "$ref": "#/$defs/date"
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "text_short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "text_long": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
